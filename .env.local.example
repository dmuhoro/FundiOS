# Convex (primary backend — see ADR-002)
NEXT_PUBLIC_CONVEX_URL=
# CONVEX_SITE_URL is built-in on Convex deployments (do not set manually).
ADMIN_KEY=
# For CI deploys (set in GitHub Actions) — optional now that the CLI is linked
CONVEX_CLI_ACCESS_TOKEN=

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# M-Pesa Daraja
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FundiOS

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Encryption
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1